# Обратный прокси и автоматический TLS.
#
# Отступы пробелами, не табуляцией. Файл уезжает на сервер внутри
# cloud-init, а тот запрещает табуляцию и молча отвергает документ
# целиком: не появятся ни этот конфиг, ни файл с настройками рядом.
# Проверка в scripts/check-cloud-init.py сторожит это.
#
# Сертификаты Let's Encrypt выпускаются и продлеваются сами: ручное
# продление однажды забывают, и сайт падает на ровном месте.
#
# Оба домена ведут в одно приложение: разделение сайта и кабинета
# делает прокси приложения по имени хоста, а не веб-сервер.

{
  email profattakhov@gmail.com
}

fattakhovhr.ru, www.fattakhovhr.ru, my.fattakhovhr.ru {
  encode zstd gzip

  # Заголовки безопасности. Строгий транспорт обязателен: без него
  # первый запрос по HTTP можно перехватить
  #
  # Referrer-Policy со знаком ? — по умолчанию, не поверх: same-origin
  # ставит и само приложение (next.config.ts), и там же объяснение —
  # адреса вида /a/applications/app_13 не должны попадать в Referer
  # чужому сервису видеовстреч. Без ? запись здесь молча переписывала
  # бы более строгое значение приложения при каждом ответе.
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    ?Referrer-Policy "same-origin"
    -Server
  }

  reverse_proxy app:3000 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Real-IP {remote_host}
  }
}

# Студенческая платформа — на своей машине fhr-students (Caddyfile.students),
# запись students ведёт туда с 03.10.2026. Блок убран отсюда 04.10.2026;
# у работающей машины он остаётся до её пересоздания (Caddyfile читается
# только при первой загрузке) — безвредно: трафика туда нет.

# Блока на :80 здесь намеренно нет.
#
# Раньше стоял временный: пускал один адрес разработчика, остальным
# отдавал 404, чтобы посмотреть сайт до переключения DNS. Убран, и
# возвращать его не стоит по трём причинам.
#
# Он занимает порт 80 целиком. Проверка владения доменом от Let's
# Encrypt приходит именно туда и с адресов центра сертификации, а не
# с нашего - то есть попадала бы под «остальным 404», и сертификаты
# могли просто не выпуститься.
#
# Его нельзя убрать после выкатки. Этот файл попадает на машину через
# write_files в cloud-init, а тот выполняется только при первой
# загрузке: правка метаданных файл на работающей машине не перепишет,
# а SSH закрыт. «Убрать после переключения DNS» на практике означало
# бы пересоздать сервер.
#
# И он почти бесполезен: до переключения DNS сертификаты всё равно не
# выпускаются, проверять нечего, а после переключения работают обычные
# домены. Журнал первой загрузки читается через
# `yc compute instance get-serial-port-output`.
