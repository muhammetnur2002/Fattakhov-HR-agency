#cloud-config
# Подготовка машины.
#
# Вход по SSH снаружи не открывается: группа безопасности пускает
# только 80 и 443. Административный доступ - через Serial Console
# облака, у неё своя аутентификация и свой журнал.
#
# Файл с секретами кладётся правами 600 и владельцем root: внутри
# контейнера он появляется только как переменные окружения, наружу
# не отдаётся.
write_files:
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "50m", "max-file": "3" }
      }

  - path: /etc/caddy/Caddyfile
    permissions: "0644"
    content: |
      ${CADDYFILE_INDENTED}

  - path: /etc/fhr.env
    permissions: "0600"
    owner: root:root
    content: |
      ${ENVFILE_INDENTED}

  # Старые образы после выкаток копятся на диске (20 ГБ): COI их сам
  # не удаляет, а одна выкатка добавляет 0,2–1,3 ГБ. Раз в сутки ночью
  # удаляются образы, которыми не пользуется ни один контейнер — ни
  # работающий, ни разовый (migrate, owner-bootstrap: их остановленные
  # контейнеры держат свои образы), — и которые старше недели. Откат
  # на прежний тег от этого не зависит: образ берётся из реестра.
  # Время сервера — UTC: 21:30 UTC = 02:30 по Екатеринбургу, вне окна
  # резервного копирования базы.
  - path: /etc/systemd/system/fhr-image-prune.service
    permissions: "0644"
    content: |
      [Unit]
      Description=FHR: удалить неиспользуемые образы Docker старше недели
      Requires=docker.service
      After=docker.service

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/env docker image prune --all --force --filter until=168h

  - path: /etc/systemd/system/fhr-image-prune.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=FHR: раз в сутки ночью удалять старые образы Docker

      [Timer]
      OnCalendar=*-*-* 21:30:00
      RandomizedDelaySec=15min
      Persistent=true

      [Install]
      WantedBy=timers.target

# Включение таймера. runcmd выполняется в конце первой загрузки, когда
# файлы выше уже лежат на месте
runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, fhr-image-prune.timer]
