# Состав машины студенческой платформы. Подставляется templatefile из students_vm.tf.
#
# Образы и переменные окружения те же, что у платформы на fhr-app; env_file нет
# намеренно: платформа получает только свои секреты, секреты CRM ей не нужны.
# Caddy и крон включаются переключателями students_vm_caddy и students_vm_cron.

# Логи контейнеров с именем службы в каждой строке — см. docker-compose.yaml.
x-logging: &logging
  driver: json-file
  options:
    max-size: "50m"
    max-file: "3"
    labels: "com.docker.compose.service"

services:
  # Миграции базы: идемпотентны, повторный запуск ничего не ломает.
  students-migrate:
    image: ${students_tools_image}
    restart: "no"
    logging: *logging
    # Потолки ресурсов: машина 2 ядра / 4 ГБ (students_vm_memory), система и
    # Docker забирают ~0,5 ГБ. Работающие службы: students 1536 + caddy 128 +
    # cron 64 + ua 256 = 1984 МБ. Загрузки до 50 МБ платформа читает в память,
    # поэтому students с запасом. Перед снижением посмотрите память в Monitoring.
    mem_limit: 512m
    cpus: 1.0
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment: ${students_env_json}
    command: ["npx", "prisma", "migrate", "deploy"]

  students:
    image: ${students_app_image}
    restart: always
    logging: *logging
    mem_limit: 1536m
    cpus: 1.5
    pids_limit: 512
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment: ${students_env_json}
    expose:
      - "3000"
    depends_on:
      students-migrate:
        condition: service_completed_successfully
    # Проверка здоровья уже есть в образе платформы (node -e fetch), не переопределяем.

  # Агент метрик и логов (память и диск машины -> Monitoring, логи -> Cloud
  # Logging). Подробности — agent.tf. Лёгкий: потолок памяти 256 МБ.
  ua:
    image: ${unified_agent_image}
    restart: always
    logging: *logging
    uts: host
    mem_limit: 256m
    cpus: 0.5
    environment:
      UA_CONFIG: ${unified_agent_config_json}
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        mkdir -p /etc/yandex/unified_agent
        printf '%s' "$$UA_CONFIG" > /etc/yandex/unified_agent/config.yml
        exec /usr/bin/unified_agent --config /etc/yandex/unified_agent/config.yml
    volumes:
      - /proc:/ua_proc:ro
      - /var/lib/docker/containers:/docker_logs:ro
      - ua_data:/var/lib/yandex/unified_agent
%{ if enable_caddy }

  caddy:
    image: caddy:2-alpine
    restart: always
    logging: *logging
    # Прокси: см. docker-compose.yaml.
    mem_limit: 128m
    cpus: 0.5
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    ports:
      - "80:80"
      - "443:443"
    # Конфигурация — переменной CADDYFILE, а не файлом из cloud-init: см.
    # docker-compose.yaml и maintenance.tf.
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        printf '%s' "$$CADDYFILE" > /tmp/Caddyfile
        exec caddy run --config /tmp/Caddyfile --adapter caddyfile
    environment:
      CADDYFILE: ${caddyfile_json}
      # Плановые работы (maintenance_mode, maintenance_bypass в prod.tfvars)
      MAINTENANCE_MODE: ${maintenance_mode_json}
      MAINTENANCE_BYPASS: ${maintenance_bypass_json}
    volumes:
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - students
%{ endif }
%{ if enable_cron }

  # Ежедневные напоминания, 09:00 по Москве (06:00 UTC). Включать только когда
  # такой же контейнер на fhr-app остановлен: иначе напоминания уйдут дважды.
  students-cron:
    image: alpine:3.20
    restart: always
    logging: *logging
    # Лимиты и no-new-privileges; cap_drop не ставим: apk add под root при
    # старте и crond используют возможности root (проверить без них нельзя).
    mem_limit: 64m
    cpus: 0.25
    pids_limit: 64
    security_opt:
      - no-new-privileges:true
    environment: ${students_env_json}
    depends_on:
      - students
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        apk add --no-cache curl >/dev/null
        echo "0 6 * * * curl -fsS -H \"Authorization: Bearer $$CRON_SECRET\" http://students:3000/api/cron/notify" > /etc/crontabs/root
        crond -f -l 2
%{ endif }

volumes:
  ua_data:
  caddy_data:
  caddy_config:
