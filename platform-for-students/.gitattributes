# Переводы строк для файлов, которые исполняются внутри Linux.
#
# На Windows git по умолчанию выдаёт CRLF. Для исходников это
# безразлично, а shell-скрипт с CRLF в контейнере падает на первой
# строке: интерпретатор ищет «/bin/sh\r». Скрипт инициализации базы
# при этом молча не выполняется, и роль приложения не появляется.

*.sh         text eol=lf
Dockerfile   text eol=lf
Caddyfile    text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
