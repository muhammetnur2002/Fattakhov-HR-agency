# ============================================================
#  Fattakhov HR Agency — платформа для студентов
#  Скопируйте в .env и заполните: cp .env.example .env
#
#  Именно .env, а не .env.local: Next.js читает оба, но Prisma CLI —
#  только .env, и с .env.local команды db:push и db:seed не увидят
#  строку подключения.
# ============================================================

# --- База данных ---------------------------------------------
# Пока переменная не задана, приложение работает в демо-режиме:
# данные живут в памяти процесса и исчезают при перезапуске.
# В production отсутствие DATABASE_URL — ошибка старта, а не демо.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fhr_students?schema=public"

# Строка для миграций — администратор базы. Обязательна: без неё Prisma
# не проходит валидацию схемы. Локально положите сюда то же самое.
#
# На бою две строки обязаны различаться. Приложение ходит ролью, которая
# умеет только читать и писать строки, а создавать и удалять таблицы —
# нет. Тогда инъекция в рантайме не сносит таблицу и не заводит роль:
# прав нет у самого подключения, а не только в проверках кода.
#
# Роль заводится один раз командой:
#   npm run db:provision
# Она создаст fhr_app со случайным паролем и перепишет обе строки здесь.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fhr_students?schema=public"

# --- Ключи ---------------------------------------------------
# Сгенерировать оба: npm run keys
#
# Мастер-ключ шифрования ПДн. Из него через HKDF выводятся подключи для
# AES-256-GCM и для слепого индекса. Потеря ключа = потеря доступа ко
# всем зашифрованным полям: ФИО, почте, телефонам. Храните в секрет-
# менеджере, а не в репозитории.
PII_ENCRYPTION_KEY=""

# Подпись сессионных JWT. Смена значения разлогинивает всех.
JWT_SECRET=""

# --- Redis (необязательно) -----------------------------------
# Нужен для честных лимитов запросов при нескольких инстансах.
# Без него лимиты считаются в памяти процесса — для одного
# инстанса в разработке этого достаточно.
REDIS_URL="redis://localhost:6379"

# --- Загруженные файлы ---------------------------------------
# Куда класть фото и резюме. По умолчанию — ./.uploads рядом с проектом.
# Каталог намеренно вне public/: файлы раздаёт роут с проверкой прав.
UPLOAD_DIR=""

# --- Синхронизация с CRM агентства ---------------------------
# Пока URL не задан, синхронизация берёт демонстрационную выгрузку из
# lib/db/seed-data.ts. Ожидаемый формат ответа: { "vacancies": [...] }
# по контракту CrmVacancyInput из lib/db/types.ts
CRM_SYNC_URL=""
CRM_SYNC_TOKEN=""

# --- Сайт агентства ------------------------------------------
# Ссылка «Сайт агентства» в подвале витрины (папка fattakhov-hr-platform-main).
# В разработке без значения ведёт на http://localhost:3000, на проде без
# значения ссылки нет. Витрина статична — переменная нужна и при сборке.
AGENCY_SITE_URL=""

# --- Почта: коды подтверждения, сброс пароля, уведомления ----
# Yandex Cloud Postbox по SMTP. Пока SMTP_URL или SMTP_FROM пусты, в
# разработке письма пишутся в лог сервера, а в production приложение не
# стартует. Логин — идентификатор API-ключа сервисного аккаунта с областью
# yc.postbox.send, пароль — секретная часть ключа (символы / и + в адресе
# записываются как %2F и %2B). Отправитель — адрес на домене, подтверждённом
# в Postbox.
#   SMTP_URL="smtps://<id-ключа>:<секрет>@postbox.cloud.yandex.net:465"
#   SMTP_FROM="Fattakhov HR Agency <noreply@fattakhovhr.ru>"
SMTP_URL=""
SMTP_FROM=""

# Адрес платформы — для ссылок в письмах. В разработке без значения
# ведёт на http://localhost:3001, в production обязателен.
APP_URL=""

# --- Вход сотрудников из CRM --------------------------------
# Общий секрет с CRM (сайт агентства): кнопка «Студенческая платформа» в
# CRM открывает панель HR без второго пароля. Одна и та же строка в .env
# обеих платформ, не короче 32 символов. Пусто — вход из CRM выключен,
# остаётся учётка HR-менеджера из admin:create.
STUDENTS_SSO_SECRET=""

# --- Служебный вызов из CRM (сервер-сервер) ------------------
# Отдельный от STUDENTS_SSO_SECRET: этот не для входа человека через
# редирект, а для того, чтобы сервер CRM сам читал и решал заявки на
# привязку клиента, справки студентов и модерацию — без захода
# сотрудника на эту платформу. Тоже общая строка не короче 32 символов,
# тоже в .env обеих платформ. Пусто — служебный API отвечает 503.
CRM_SERVICE_SECRET=""

# --- Билет входа в CRM (обратное направление от STUDENTS_SSO_SECRET) ---
# Компания, которую сотрудник CRM объединил с профилем здесь, входит в
# CRM тем же паролем — без второй регистрации. Общая строка с .env CRM
# (CRM_ENTRY_SECRET), не короче 32 символов. Пусто — кнопка «Войти в CRM»
# не работает.
CRM_ENTRY_SECRET=""
