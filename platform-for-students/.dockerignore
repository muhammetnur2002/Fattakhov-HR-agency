# Что не попадает в образ.
#
# Главное здесь — секреты и чужая ОС. `.env` в образе означает ключ
# шифрования ПДн в каждом слое, который когда-либо уедет в реестр.
# `node_modules` с машины разработчика содержит бинарники под Windows и
# перезаписал бы зависимости, собранные внутри Linux-образа.

node_modules
.next
.git
.gitignore

.env
.env.*
!.env.example
deploy/.env

# Загруженные фото и резюме — персональные данные
.uploads
backups

# Для работы не нужно
figma
tests
coverage
*.tsbuildinfo
npm-debug.log*
.DS_Store
