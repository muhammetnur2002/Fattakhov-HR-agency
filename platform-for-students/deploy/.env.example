# Боевые настройки платформы для студентов.
#
#   cp deploy/.env.example deploy/.env
#
# и заполнить. deploy/.env в git не попадает: в нём ключ шифрования
# персональных данных и пароли базы.
#
# Все пароли — только латинские буквы и цифры. Они подставляются в
# строки подключения и в SQL, и символ вроде @ или ' ломает то и другое
# так, что ошибка всплывает далеко от места, где её сделали.
# Сгенерировать подходящий:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"


# --- Адрес ---------------------------------------------------------
# Домен, на котором откроется платформа. DNS-запись (A) этого домена
# должна указывать на сервер ДО первого запуска: иначе Let's Encrypt не
# выпустит сертификат, и сайт не откроется по HTTPS.
SITE_DOMAIN=""

# Почта для Let's Encrypt: туда приходят предупреждения, если сертификат
# почему-то перестанет продлеваться сам.
ACME_EMAIL=""


# --- Своя база: только при запуске с --profile db ------------------
# С управляемой базой эти две строки не нужны.
#
# Пароль администратора базы. Им ходят только миграции.
POSTGRES_ADMIN_PASSWORD=""
# Пароль роли приложения fhr_app. Роль заводится сама при первом старте
# базы и умеет только читать и писать строки.
APP_DB_PASSWORD=""


# --- Строки подключения --------------------------------------------
# Две строки, и они обязаны различаться по правам:
#   DATABASE_URL         приложение — роль fhr_app, без права менять схему
#   DIRECT_DATABASE_URL  миграции — администратор базы
#
# Своя база (--profile db): подставьте пароли из блока выше.
DATABASE_URL="postgresql://fhr_app:ПАРОЛЬ_ПРИЛОЖЕНИЯ@postgres:5432/fhr_students?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:ПАРОЛЬ_АДМИНИСТРАТОРА@postgres:5432/fhr_students?schema=public"
#
# Управляемая база: адрес хоста из консоли облака и обязательно
# sslmode=require — трафик до неё идёт по сети провайдера, а не внутри
# сервера. Роль приложения заводится командой npm run db:provision
# с машины, у которой есть доступ к базе.
#   DATABASE_URL="postgresql://fhr_app:...@<хост>:6432/fhr_students?schema=public&sslmode=require"
#   DIRECT_DATABASE_URL="postgresql://<админ>:...@<хост>:6432/fhr_students?schema=public&sslmode=require"


# --- Ключи ---------------------------------------------------------
# Сгенерировать оба: npm run keys
#
# НОВЫЕ ключи для боя. Не переносите ключи с машины разработчика: они
# лежали в .env рядом с кодом и считаются скомпрометированными.
#
# PII_ENCRYPTION_KEY храните ОТДЕЛЬНО от резервных копий базы, например
# в менеджере паролей. Копия базы без этого ключа восстанавливает всё,
# кроме ФИО, почт и телефонов — то есть всё, кроме людей.
# Сменить ключ потом можно только перешифровкой: npm run keys:rotate.
PII_ENCRYPTION_KEY=""

# Подпись сессий. Смена значения разлогинивает всех.
JWT_SECRET=""


# --- Загруженные файлы ---------------------------------------------
# Не очищайте и не делайте пустым. В образе этот путь смонтирован на
# постоянный том. Пустое значение здесь перебило бы его, файлы легли бы
# внутрь контейнера и пропали при первой же пересборке.
UPLOAD_DIR="/data/uploads"


# --- Redis (необязательно) -----------------------------------------
# Для одного экземпляра приложения не нужен. Понадобится, когда
# экземпляров станет больше одного — иначе лимиты запросов и живая
# переписка будут работать в пределах каждого процесса отдельно.
REDIS_URL=""


# --- Синхронизация с CRM агентства ---------------------------------
# Пока адрес не задан, синхронизация на бою отказывает с понятной
# ошибкой. Демонстрационные вакансии в боевую базу не попадают.
CRM_SYNC_URL=""
CRM_SYNC_TOKEN=""
