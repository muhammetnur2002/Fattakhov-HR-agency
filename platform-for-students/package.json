{
  "name": "fattakhov-students",
  "version": "1.0.0",
  "private": true,
  "description": "Fattakhov HR Agency — платформа подбора вакансий для студентов",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:provision": "node scripts/db-provision.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:clean-test": "node scripts/db-clean-test.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "keys": "tsx scripts/generate-keys.ts",
    "keys:rotate": "node --conditions=react-server --import tsx scripts/rotate-pii-key.ts",
    "smoke": "tsx tests/smoke.ts",
    "test:unit": "tsx tests/unit.ts",
    "db:connect": "node scripts/db-connect.mjs",
    "employer:code": "node --conditions=react-server --import tsx scripts/issue-access-code.ts",
    "institutions:load": "node --conditions=react-server --import tsx scripts/load-institutions.ts",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-admin.ts",
    "password:set": "node --conditions=react-server --import tsx scripts/set-password.ts",
    "notify:run": "node --conditions=react-server --import tsx scripts/notify.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.687.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.462.0",
    "next": "^14.2.35",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
