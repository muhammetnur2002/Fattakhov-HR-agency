# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# симлинк на ТЗ (мастер-копия лежит в ~/Скиллы/HR-платформа)
/docs/spec.md

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# скиллы для других редакторов (используем .agents)
/.windsurf
/.cursor

# Локальное хранилище файлов (разработка). В проде — российский S3, BR-32.
.storage/

# Playwright (tests/e2e): сохранённые сессии входа и отчёты о прогонах —
# первые содержат токен сессии, вторые просто мусор между запусками
/tests/e2e/.auth/
/test-results/
/playwright-report/
/blob-report/
