import { defineConfig } from "vitest/config";

export default defineConfig({
  resolve: {
    // Разрешает алиас @/* из tsconfig нативно, без плагина
    tsconfigPaths: true,
  },
  test: {
    // По умолчанию — node: большинство тестов ходят в реальный Postgres
    // и document не видят вовсе, им он там не нужен и не должен быть
    // нужен. Компонентным (tests/components/**) он нужен — они сами
    // переключают себе среду строкой `// @vitest-environment jsdom`
    // первой строкой файла: это единственный работающий в этой версии
    // Vitest способ задать среду по файлам — опция environmentMatchGlobs
    // здесь не типизирована и на деле тоже не переключает среду.
    environment: "node",
    setupFiles: ["tests/setup.ts"],
    include: ["tests/**/*.test.ts", "tests/**/*.test.tsx"],
    // Файлы идут по одному: часть тестов пишет в общую тестовую базу,
    // и параллельный запуск даёт плавающие падения — один файл видит
    // данные, созданные другим на середине его сценария. Компонентные
    // тесты в базу не пишут, но общий флаг проще, чем городить два
    // раздельных прогона ради выигрыша в несколько секунд.
    fileParallelism: false,
    // e2e на Playwright лежат отдельно и запускаются своим раннером
    exclude: ["tests/e2e/**", "node_modules/**"],
  },
});
