# Скопировать в .env и подставить свои значения.
#
# Локальный Postgres (macOS, Homebrew):
#   brew install postgresql@16
#   brew services start postgresql@16
#   createdb hr_platform && createdb hr_platform_test
# <user> — имя пользователя ОС, Homebrew создаёт роль с ним автоматически.

DATABASE_URL=""postgresql://postgres:postgres@localhost:5432/hr_platform?schema=public"
DATABASE_URL_TEST=""postgresql://postgres:postgres@localhost:5432/hr_platform_test?schema=public"

# --- Аутентификация (Этап 1) ---
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Адреса (разводятся при деплое) ---
#
# APP_URL   кабинеты и все ссылки, которые уходят людям: приглашение,
#           согласие на ПДн, выбор времени интервью, лента календаря
# SITE_URL  лендинг
#
# Локально обе роли на одном адресе, поэтому здесь пусто: APP_URL
# подхватывает AUTH_URL, SITE_URL подхватывает APP_URL.
#
# На проде:
#   APP_URL="https://app.fattakhov.ru"
#   SITE_URL="https://fattakhov.ru"
#
# Как только SITE_URL задан, прокси начинает разделять домены:
# на сайте открывается только лендинг, всё прочее уезжает в приложение,
# а корень приложения уводит анонима на сайт. Пока переменная пуста,
# всё работает на одном адресе, как сейчас.
#
# STUDENTS_URL  студенческая платформа (отдельное приложение, папка
#               platform_for_students): кнопки «Студентам» в шапке,
#               в подвале и блок на главной. Локально без значения
#               ведёт на http://localhost:3001. На проде без значения
#               кнопок нет вовсе. Главная собирается статически, так что
#               переменная нужна и при сборке, а не только при запуске.
# STUDENTS_URL=""
#
# STUDENTS_SSO_SECRET  секрет входа из CRM в панель студенческой платформы
#               (раздел «Студенческая платформа»). Одна и та же строка в .env
#               обеих платформ, не короче 32 символов: openssl rand -base64 32.
#               Без него кнопка входа не работает, остальное — как обычно.
# STUDENTS_SSO_SECRET=""
#
# CRM_SERVICE_SECRET  секрет для вызовов сервер-сервер на студенческую
#               платформу (заявки на привязку клиента, дальше — справки
#               и модерация): CRM сама читает и решает их, без захода
#               сотрудника на тот сайт. Отдельная строка от
#               STUDENTS_SSO_SECRET, тоже общая с .env студенческой
#               платформы, тоже не короче 32 символов.
# CRM_SERVICE_SECRET=""
#
# CRM_ENTRY_SECRET  секрет билета входа в CRM со студенческой платформы —
#               обратное направление от STUDENTS_SSO_SECRET. Только для
#               компании, которую сотрудник CRM уже объединил с профилем
#               там: дальше она входит в CRM тем же паролем. Общая строка
#               с .env студенческой платформы, не короче 32 символов.
# CRM_ENTRY_SECRET=""
# APP_URL=""
# SITE_URL=""

# --- Файлы (Этап 4) ---
# Локальный каталог для разработки.
FILE_STORAGE_PATH=".storage"

# --- Уведомления (Этап 7) ---
# Пока не заданы, письма и сообщения пишутся в лог. Это рабочий режим
# разработки: он позволяет прогнать все события, ничего не отправив
# живым людям на тестовых данных.
#
# Почта: строка подключения SMTP и адрес отправителя. На проде обе
# переменные обязательны, и без них приложение не поднимется: почтой
# уходят приглашения и ссылки сброса пароля, и в режиме «пишем в лог»
# они одновременно перестают работать и оказываются не там, где
# персональным данным место.
#   SMTP_URL="smtp://user:pass@smtp.example.ru:465"
#   SMTP_FROM="Платформа <noreply@example.ru>"
#
# Yandex Cloud Postbox — там же, где база. Логин — идентификатор API-ключа
# сервисного аккаунта с областью yc.postbox.send, пароль — секрет ключа;
# отправитель — адрес на домене, подтверждённом в Postbox (DKIM в reg.ru).
# Этот же отправитель подходит и студенческой платформе.
#   SMTP_URL="smtps://<id-ключа>:<секрет>@postbox.cloud.yandex.net:465"
#   SMTP_FROM="Fattakhov HR Agency <noreply@fattakhovhr.ru>"
#
# Telegram: токен от @BotFather (команда /newbot). Каждый пользователь
# дополнительно указывает свой идентификатор чата в настройках.
# В отличие от почты, канал необязательный: без токена его просто нет.
#   TELEGRAM_BOT_TOKEN=""
#
# Фоновые задачи (напоминания, просрочки, сводки) — отдельный процесс:
#   npm run worker         постоянный цикл, раз в минуту
#   npm run worker:once    один проход, для cron и проверки вручную

# --- Хранилище файлов на проде ---
#
# Прод обязан хранить файлы в российском S3 (BR-32, локализация ПДн).
# Пока переменные пусты, файлы лежат на диске в FILE_STORAGE_PATH -
# это режим разработки. При NODE_ENV=production приложение с пустыми
# S3_* не запустится вовсе, и это сделано намеренно: тихо свалиться
# на локальный диск значит разложить резюме по диску сервера
# и потерять их при первом перезапуске.
#
# Задавать нужно все четыре сразу. Половина настроек - ошибка,
# приложение скажет об этом на старте.
#
# Яндекс Object Storage:
#   S3_ENDPOINT="https://storage.yandexcloud.net"
#   S3_BUCKET="fhr-files"
#   S3_ACCESS_KEY_ID=""          # статический ключ сервисного аккаунта
#   S3_SECRET_ACCESS_KEY=""
#   S3_REGION="ru-central1"      # по умолчанию уже такой

# --- Мониторинг ошибок ---
#
# Необязательный, как и Telegram выше: без него Sentry просто не
# поднимается (instrumentation.ts и instrumentation-client.ts), падения
# уходят только в лог процесса. DSN — не секрет, это публичный
# идентификатор приёма событий (так и у самого Sentry в документации),
# поэтому один и тот же публичный NEXT_PUBLIC_-префикс годится и на
# сервер, и в браузер — не нужно заводить два раздельных значения.
#   NEXT_PUBLIC_SENTRY_DSN=""

# --- Яндекс.Метрика ---
#
# Номер счётчика заводится на metrika.yandex.ru самим владельцем
# аккаунта. Пока переменная пуста, счётчик на лендинге не подключается
# вовсе (components/analytics/metrika.tsx) — это не ошибка, а ожидаемое
# состояние до того, как счётчик создан.
#   NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# --- Что обязательно на проде ---
#
# При NODE_ENV=production приложение проверяет настройки один раз
# на старте (instrumentation.ts) и отказывается подниматься, если
# чего-то нет. Список короткий, и каждый пункт — про то, без чего
# платформа именно неисправна, а не про удобство:
#
#   S3_*                  файлы кандидатов (BR-32, локализация ПДн)
#   SMTP_URL, SMTP_FROM   приглашения и сброс пароля
#   AUTH_SECRET           подпись сессий, ссылок на файлы и лент календаря
#   APP_URL (или AUTH_URL) адрес в ссылках, которые уходят людям
#
# Отказ на старте выглядит грубо, но ошибку видно на выкатке,
# а не через неделю по жалобе человека, которому не пришло письмо.
#
# Кроме переменных, старт в проде держит ещё одно условие: текст
# согласия на обработку персональных данных должен быть заменён
# на выверенный юристом (lib/services/consent.ts). Пока там заглушка
# с версией «draft-1», приложение не поднимется. Заглушка не выглядит
# поломкой — форма открывается, галочка ставится, согласие пишется
# в базу, — и отличить такое согласие от настоящего можно будет только
# постфактум, по версии внутри записи.
#
# Тестовые данные на прод не заводятся: `prisma db seed` при
# NODE_ENV=production откажется работать (он стирает базу и создаёт
# учётки с общим паролем). Первая настройка прода — npm run setup:real:
# создаётся организация и приглашение владельцу, пароль владелец
# задаёт сам.
