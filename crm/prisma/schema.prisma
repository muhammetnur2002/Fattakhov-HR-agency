// HR-платформа — схема данных
// Источник правды: ТЗ раздел 5.2 (/Users/timur/Скиллы/HR-платформа/ТЗ_HR_платформа_v1.md)
// Любое изменение здесь синхронизируется обратно в ТЗ.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ОРГАНИЗАЦИЯ И ПОЛЬЗОВАТЕЛИ ============

model Organization {
  id        String   @id @default(cuid())
  name      String
  inn       String?
  logoUrl   String?
  settings  Json     @default("{}") // рабочие часы, таймзона, дефолтные этапы воронки
  createdAt DateTime @default(now())

  users      User[]
  clients    Client[]
  candidates Candidate[]
  vacancies  Vacancy[]

  disclosureConsents DisclosureConsent[]
}

enum UserRole {
  OWNER
  HEAD
  RECRUITER
  ACCOUNT
  CLIENT_ADMIN
  CLIENT_HIRING
  CLIENT_VIEWER
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email        String
  phone        String?
  fullName     String
  passwordHash String?
  avatarUrl    String?
  role         UserRole
  position     String? // должность, отображается клиенту
  /// Доступы сверх роли, выданные владельцем: управление командой,
  /// разделы студенческой платформы. Коды — STAFF_GRANTS в lib/access.
  grants       String[] @default([])
  timezone     String   @default("Europe/Moscow")

  // Заполнено только для ролей CLIENT_*
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  /// Числовой id страницы ВКонтакте. Хранится id, а не адрес профиля:
  /// короткое имя человек может сменить, id — нет.
  vkUserId       String?
  notifyPrefs    Json    @default("{}") // { email: true, vk: true, push: true, digest: "instant"|"daily" }

  /// Устройства, на которых человек включил пуш-уведомления.
  pushSubscriptions PushSubscription[]
  studentMessageDrafts StudentMessageDraft[]

  /// Проверенная личность для быстрого входа (регистрация по номеру
  /// телефона, см. lib/services/quick-registration.ts).
  ///
  /// Отдельное поле, а не phone, и это не дублирование. phone — то, что
  /// человек сам вписал в профиль: любой текст, никем не проверенный.
  /// Если бы вход искал пользователя по phone, один человек мог бы вписать
  /// себе чужой номер — и владелец этого номера, войдя по SMS, попал бы
  /// в чужой кабинет. Здесь только то, что доказано кодом из SMS. Пишет
  /// его только вход, никакая форма настроек.
  ///
  /// Номер в E.164 (+79991234567), подтверждённый кодом из SMS.
  phoneVerified  String? @unique
  /// Адрес, который человек назвал сам (анкета, настройки), — до нажатия
  /// кнопки по ссылке из письма. Рабочим (email) становится только после
  /// неё: на email уходят уведомления о кандидатах и ссылки сброса пароля.
  pendingEmail   String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  /// Когда человек в последний раз был в кабинете — пульс открытой вкладки
  /// (components/presence/presence-heartbeat.tsx), запись не чаще раза
  /// в минуту (lib/services/presence.ts). Видна только тем, кто вправе ему
  /// писать (lib/services/messages.ts), и только если статус не скрыт владельцем.
  lastSeenAt  DateTime?
  /// «Показывать, что я в сети»: false действует ТОЛЬКО у владельца агентства
  /// (OWNER) — статус никому не виден, пульс не пишется, прежняя отметка
  /// стирается. У остальных ролей значение игнорируется (effectiveShowPresence
  /// в lib/presence.ts), в том числе сохранённое false из прошлых версий.
  showPresence Boolean  @default(true)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  /// Клиент с договором просит удалить аккаунт: пока владелец агентства не
  /// подтвердил, аккаунт работает. У клиента без договора удаление сразу, без запроса.
  deletionRequestedAt DateTime?

  /// Секрет для одноразовых кодов. Заполнен с момента, когда человек
  /// начал подключение, но второй фактор требуется только после
  /// totpEnabledAt: иначе брошенное на полпути подключение заперло бы
  /// человека снаружи.
  totpSecret    String?
  totpEnabledAt DateTime?
  /// Последний принятый шаг кода: тот же код второй раз не проходит.
  totpLastStep  Int?

  /// Версия ссылки на календарь: «Обновить ссылку» увеличивает её и гасит прежние ссылки.
  calendarTokenVersion Int @default(0)

  /// Момент последней смены пароля. Сессии, выпущенные раньше, считаются
  /// недействительными: сменил пароль - вышел везде, кроме текущего места.
  /// Без этого угнанная сессия переживает смену пароля до 30 дней.
  passwordChangedAt DateTime?

  invitesSent      Invitation[]    @relation("InviteAuthor")
  comments         Comment[]
  activities       ActivityLog[]
  passwordResets   PasswordReset[]
  recoveryCodes    RecoveryCode[]
  sentMessages     DirectMessage[] @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")

  // Подтверждения передачи данных работодателю: кто запросил у кандидата
  // и кто отметил вручную, без следа самого кандидата
  disclosuresRequested DisclosureConsent[] @relation("DisclosureRequestedBy")
  disclosuresConfirmed DisclosureConsent[] @relation("DisclosureConfirmedBy")

  @@unique([organizationId, email])
  @@index([clientId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           UserRole
  clientId       String?
  /// Должность и доступы сотрудника агентства — переходят в учётку при приёме
  position       String?
  grants         String[]  @default([])
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  // Пусто у приглашения, созданного системой при первичной настройке:
  // первого владельца звать некому, пользователей ещё нет
  createdById    String?
  createdBy      User?     @relation("InviteAuthor", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())

  @@index([organizationId, email])
}

// ============ КЛИЕНТЫ И ДОГОВОРЫ ============

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  legalName   String?
  inn         String?
  industry    String?
  website     String?
  logoUrl     String?
  description String? @db.Text // «о компании» — рекрутер использует, продавая вакансию кандидату
  city        String?

  accountManagerId String? // ответственный ACCOUNT со стороны агентства

  status    ClientStatus @default(LEAD)
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  // true, если клиент сам пришёл со студенческой платформы (уже там был,
  // рекламировать её ему незачем)
  fromStudentsPlatform Boolean @default(false)

  /// Компания зарегистрировалась сама на /register — по телефону
  /// или по почте, — а не заведена агентством. Такой анкета
  /// после входа нужна: при регистрации спрашивается только способ входа.
  selfRegisteredAt DateTime?
  /// Анкета после регистрации пройдена: название, контакт, кого ищут.
  /// Пока пусто у самостоятельно зарегистрированной компании, кабинет
  /// уводит на /onboarding с анкетой. У заведённых агентством не
  /// заполняется и не нужна — их данные вносит агентство.
  briefCompletedAt DateTime?

  users       User[]
  agreements  Agreement[]
  vacancies   Vacancy[]
  invoices    Invoice[]
  attachments Attachment[]
  leads       Lead[]

  disclosureConsents DisclosureConsent[]

  @@index([organizationId, status])
}

enum ClientStatus {
  LEAD // завели, договор не подписан
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PricingModel {
  PERCENT_ANNUAL // % от годового дохода кандидата
  PERCENT_MONTHLY // N окладов
  FIXED_PER_HIRE // фикс за закрытую позицию
  SUBSCRIPTION // абонентская плата, N вакансий в работе
  HOURLY // почасовая
}

model Agreement {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id])

  title        String // «Договор №12 от 01.08.2026»
  pricingModel PricingModel

  // Параметры зависят от модели. Валидация — в бизнес-слое, не в БД.
  percentRate        Decimal? @db.Decimal(5, 2) // для PERCENT_*: например 18.00
  monthsCount        Int? // для PERCENT_MONTHLY: 2 оклада
  fixedAmount        Decimal? @db.Decimal(12, 2)
  subscriptionAmount Decimal? @db.Decimal(12, 2)
  subscriptionSlots  Int? // сколько вакансий одновременно
  hourlyRate         Decimal? @db.Decimal(10, 2)

  guaranteeDays     Int     @default(90) // гарантийный период замены
  paymentTerms      String? @db.Text // «50% предоплата, 50% при выходе»
  prepaymentPercent Int     @default(0)

  startsAt DateTime
  endsAt   DateTime?
  status   AgreementStatus @default(PENDING)

  fileUrl          String? // скан подписанного договора
  acceptedByUserId String? // кто со стороны клиента подтвердил условия
  acceptedAt       DateTime?

  createdAt   DateTime     @default(now())
  vacancies   Vacancy[]
  attachments Attachment[]

  @@index([clientId, status])
}

enum AgreementStatus {
  PENDING // клиент выбрал условия, агентство не подтвердило
  ACTIVE
  EXPIRED
  TERMINATED
}

// ============ ВАКАНСИИ ============

enum VacancyStatus {
  DRAFT // черновик клиента
  SUBMITTED // заявка отправлена, агентство не приняло
  CLARIFYING // агентство задало вопросы
  ESTIMATED // агентство прислало срок/условия, ждём подтверждения клиента
  ACTIVE // в работе
  ON_HOLD // приостановлена
  CLOSED_SUCCESS // закрыта наймом
  CLOSED_CANCELLED // отменена клиентом
  CLOSED_FAILED // агентство не смогло закрыть
}

enum WorkFormat {
  OFFICE
  REMOTE
  HYBRID
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  PROJECT
  GPH // договор ГПХ
  SELF_EMPLOYED
}

enum VacancyUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model Vacancy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  agreementId    String?
  agreement      Agreement?   @relation(fields: [agreementId], references: [id])

  number Int // человекочитаемый номер в рамках организации
  title  String
  status VacancyStatus @default(DRAFT)

  // --- БРИФ ---
  department      String?
  hiringManagerId String? // CLIENT_HIRING — заказчик со стороны клиента
  headcount       Int     @default(1)
  reasonForHire   String? // рост / замена / новая функция

  responsibilities String? @db.Text
  requirements     String? @db.Text
  niceToHave       String? @db.Text
  conditions       String? @db.Text // что предлагает работодатель

  salaryFrom     Decimal? @db.Decimal(12, 2)
  salaryTo       Decimal? @db.Decimal(12, 2)
  salaryCurrency String   @default("RUB")
  salaryGross    Boolean  @default(true)
  bonusScheme    String?

  city           String?
  workFormat     WorkFormat?
  employmentType EmploymentType?
  workSchedule   String? // «5/2, 9:00–18:00»

  // --- ПАРАМЕТРЫ ПОДБОРА ---
  stopFactors      String?        @db.Text // кого точно не рассматриваем
  targetCompanies  String?        @db.Text // откуда хантить
  interviewStages  String?        @db.Text // как выглядит процесс отбора у клиента
  urgency          VacancyUrgency @default(NORMAL)
  desiredStartDate DateTime?

  // --- РАБОТА АГЕНТСТВА ---
  leadRecruiterId            String?
  recruiterIds               String[]  @default([])
  estimatedFirstCandidatesAt DateTime? // обещанная дата первых кандидатов
  estimatedCloseAt           DateTime?
  agencyNotes                String?   @db.Text // внутреннее, клиенту не видно

  submittedAt DateTime?
  activatedAt DateTime?
  closedAt    DateTime?
  closeReason String?

  isReplacementFor String? // id закрытой вакансии, если это замена по гарантии

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  stages       PipelineStage[]
  applications Application[]
  interviews   Interview[]
  comments     Comment[]
  attachments  Attachment[]

  disclosureConsents DisclosureConsent[]

  @@unique([organizationId, number])
  @@index([clientId, status])
  @@index([leadRecruiterId, status])
}

// ============ ВОРОНКА ============

// Этапы настраиваются под вакансию, создаются из шаблона организации
model PipelineStage {
  id        String  @id @default(cuid())
  vacancyId String
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  code            String // LONGLIST | SCREENING | PRESENTED | CLIENT_INTERVIEW | FINAL | OFFER | HIRED
  name            String // отображаемое имя, редактируемое
  order           Int
  visibleToClient Boolean @default(true) // ключевое: LONGLIST и SCREENING = false
  isTerminal      Boolean @default(false) // HIRED
  slaHours        Int? // норматив нахождения на этапе

  applications Application[]

  @@unique([vacancyId, code])
  @@index([vacancyId, order])
}

// ============ КАНДИДАТЫ ============

enum CandidateSource {
  HH
  AVITO
  TELEGRAM
  LINKEDIN
  REFERRAL
  OWN_BASE
  DIRECT_SEARCH
  INBOUND
  OTHER
}

enum ConsentStatus {
  PENDING
  GIVEN
  REVOKED
  EXPIRED
}

model Candidate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  fullName  String
  phone     String?
  email     String?
  telegram  String?
  city      String?
  birthYear Int?

  currentPosition      String?
  currentCompany       String?
  totalExperienceYears Decimal? @db.Decimal(4, 1)
  skills               String[] @default([])
  languages            Json? // [{lang:"en", level:"B2"}]
  education            String?  @db.Text
  summary              String?  @db.Text // внутреннее саммари рекрутера

  salaryExpectation Decimal? @db.Decimal(12, 2)
  salaryCurrency    String   @default("RUB")

  source        CandidateSource @default(OTHER)
  sourceDetails String? // ссылка на профиль hh / откуда пришёл

  // ПДн-контур (BR-33, BR-34)
  consentStatus    ConsentStatus @default(PENDING)
  consentGivenAt   DateTime?
  consentExpiresAt DateTime?
  consentDocUrl    String?

  // Версия текста, на который человек соглашался: если текст изменится,
  // должно быть видно, под чем именно стоит его согласие
  consentVersion String?

  // Одноразовая ссылка на форму согласия
  consentToken          String?   @unique
  consentTokenExpiresAt DateTime?

  // Сорсинг-лид (регламент юриста, lib/services/sourcing.ts): человека
  // нашёл рекрутер, данные получены не от него. Отметка ставится при
  // заведении; режим действует, пока согласия нет (consentStatus PENDING):
  // только имя, контакты и ссылка на профиль, срок — 14 дней
  sourcedAt          DateTime?
  // Когда человека уведомили, что его данные у нас (ст. 18 152-ФЗ)
  sourcingNoticeAt   DateTime?
  // Напоминание заведшему о сроке уже ушло — второй раз не шлём
  sourcingReminderAt DateTime?

  /// Контур уничтожения ПДн (ст. 21 152-ФЗ). Подробности — у ErasureState.
  erasureState       ErasureState   @default(ACTIVE)
  erasureReason      ErasureReason?
  /// Когда возникло основание: отзыв, истечение, требование.
  erasureRequestedAt DateTime?
  /// Крайний срок уничтожения по закону. По нему считается просрочка.
  erasureDueAt       DateTime?
  /// Когда фактически обезличено.
  erasedAt           DateTime?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  applications Application[]
  attachments  Attachment[]

  disclosureConsents DisclosureConsent[]

  @@index([organizationId, fullName])
  @@index([organizationId, phone])
}

/// Почему нанятый ушёл в гарантийный срок.
enum GuaranteeBreakReason {
  CANDIDATE_LEFT // ушёл сам
  DISMISSED // уволил работодатель
  PROBATION_FAILED // не прошёл испытательный срок
  OTHER
}

enum ApplicationOutcome {
  IN_PROGRESS
  HIRED
  REJECTED
  WITHDRAWN // кандидат сам отказался
  ON_HOLD // клиент взял паузу
}

enum ClientDecision {
  INTERVIEW
  HOLD
  REJECT
  OFFER
}

enum RejectionSide {
  CLIENT
  CANDIDATE
  AGENCY
}

enum RejectionReason {
  // от клиента
  EXPERIENCE_MISMATCH
  SKILLS_MISMATCH
  SALARY_TOO_HIGH
  CULTURE_FIT
  OVERQUALIFIED
  LOCATION
  FAILED_INTERVIEW
  FAILED_TEST_TASK
  POSITION_CLOSED
  // от кандидата
  ACCEPTED_OTHER_OFFER
  SALARY_TOO_LOW
  NOT_INTERESTED
  COUNTEROFFER
  CONDITIONS_MISMATCH
  NO_CONTACT
  NO_SHOW
  OTHER
}

// Участие кандидата в конкретной вакансии — центральная рабочая сущность
model Application {
  id             String        @id @default(cuid())
  organizationId String
  vacancyId      String
  vacancy        Vacancy       @relation(fields: [vacancyId], references: [id])
  candidateId    String
  candidate      Candidate     @relation(fields: [candidateId], references: [id])
  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])

  stageEnteredAt DateTime @default(now())

  outcome          ApplicationOutcome @default(IN_PROGRESS)
  rejectionReason  RejectionReason?
  rejectionComment String?            @db.Text
  rejectedBy       RejectionSide?

  // Материалы представления клиенту (заполняются перед переводом в PRESENTED, BR-4)
  presentationSummary String?   @db.Text // «почему подходит» — видно клиенту
  presentedAt         DateTime?
  presentedById       String?

  // Решение клиента (BR-12, BR-14)
  clientDecision        ClientDecision?
  clientDecisionAt      DateTime?
  clientDecisionById    String?
  submittedOnBehalfById String? // если решение внёс сотрудник агентства со слов клиента

  // Оффер
  offerSalary    Decimal?  @db.Decimal(12, 2)
  offerPosition  String?
  offerSentAt    DateTime?
  offerStartDate DateTime?

  // Найм и гарантия (BR-10). Пишет moveStage при переводе в «Нанят»:
  // от hiredAt зависят счёт и аналитика наймов, от guaranteeUntil — замена
  hiredAt               DateTime?
  guaranteeUntil        DateTime?
  /// Гарантийный случай (BR-10): человек ушёл в гарантийный срок.
  /// Дата ухода, а не дата записи: по ней решается, был ли срок.
  guaranteeBrokenAt     DateTime?
  guaranteeBreakReason  GuaranteeBreakReason?
  guaranteeBreakComment String?
  /// Этот найм — замена по гарантии для указанного найма. Замену
  /// не выставляют в счёт: за неё уже заплачено исходным наймом.
  replacementForId      String?

  ownerId  String // рекрутер, ведущий этого кандидата
  priority Int    @default(0) // сортировка в канбане

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transitions StageTransition[]
  comments    Comment[]
  interviews  Interview[]
  attachments Attachment[]

  @@unique([vacancyId, candidateId]) // BR-6
  @@index([vacancyId, stageId])
  @@index([ownerId, outcome])
}

model StageTransition {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStageId          String?
  toStageId            String
  fromOutcome          ApplicationOutcome?
  toOutcome            ApplicationOutcome?
  comment              String?             @db.Text
  hoursInPreviousStage Decimal?            @db.Decimal(10, 2)

  actorId   String
  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
}

// ============ КОММУНИКАЦИЯ ============

enum CommentVisibility {
  INTERNAL // только агентство
  SHARED // видно клиенту
}

model Comment {
  id             String       @id @default(cuid())
  organizationId String
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vacancyId      String?
  vacancy        Vacancy?     @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  body             String            @db.Text // markdown
  visibility       CommentVisibility @default(SHARED)
  mentionedUserIds String[]          @default([])

  // тред
  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentThread")

  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  readBy CommentRead[]

  @@index([applicationId, createdAt])
  @@index([vacancyId, createdAt])
}

model CommentRead {
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  readAt    DateTime @default(now())

  @@id([commentId, userId])
}

/// Личная переписка между двумя людьми.
///
/// Отдельная сущность, а не Comment с получателем: комментарий всегда
/// привязан к кандидату или вакансии и живёт по правилам их видимости,
/// а личное сообщение существует само по себе. Смешав их, пришлось бы
/// в каждом запросе объяснять, почему у половины строк нет вакансии.
///
/// Собственной «беседы» здесь нет намеренно: беседа — это просто пара
/// людей, и хранить её отдельной строкой значит держать её в согласии
/// с сообщениями вручную. Список бесед собирается запросом (см.
/// lib/services/messages.ts).
model DirectMessage {
  id             String @id @default(cuid())
  organizationId String

  senderId    String
  sender      User   @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User   @relation("ReceivedMessages", fields: [recipientId], references: [id])

  body String @db.Text

  /// Прочитано получателем. null — непрочитано; отдельной таблицы,
  /// как у комментариев, не нужно: у сообщения ровно один получатель.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([senderId, createdAt])
  @@index([organizationId, createdAt])
}

// ============ ИНТЕРВЬЮ И КАЛЕНДАРЬ ============

enum InterviewStatus {
  SLOTS_REQUESTED // нужно предложить слоты
  SLOTS_PROPOSED // слоты предложены, ждём кандидата
  CONFIRMED
  RESCHEDULE_REQUESTED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewFormat {
  ONLINE
  OFFICE
  PHONE
}

enum InterviewType {
  SCREENING // рекрутер × кандидат
  CLIENT // клиент × кандидат
  FINAL
  TEST_TASK_REVIEW
}

model Interview {
  id             String      @id @default(cuid())
  organizationId String
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vacancyId      String
  vacancy        Vacancy     @relation(fields: [vacancyId], references: [id])

  type   InterviewType
  status InterviewStatus @default(SLOTS_REQUESTED)
  format InterviewFormat @default(ONLINE)

  meetingUrl      String?
  address         String?
  durationMinutes Int     @default(60)

  participantUserIds String[]  @default([]) // кто со стороны клиента/агентства
  scheduledAt        DateTime? // подтверждённое время (UTC)
  timezone           String    @default("Europe/Moscow")

  candidateToken String?   @unique // токен публичной ссылки выбора слота
  tokenExpiresAt DateTime?

  // Токен гасится в момент выбора времени, но кнопка «добавить
  // в календарь» на экране успеха им ещё пользуется — сохраняем
  // последний, чтобы .ics отдавался без входа в систему
  lastCandidateToken String? @unique

  // Обратная связь после интервью
  feedbackRating Int? // 1..5
  feedbackNote   String?   @db.Text
  feedbackById   String?
  feedbackAt     DateTime?

  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?

  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cancelledAt  DateTime?
  cancelReason String?

  slots InterviewSlot[]

  @@index([vacancyId, scheduledAt])
  @@index([organizationId, scheduledAt])
}

model InterviewSlot {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  isSelected  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([interviewId])
}

// ============ ФАЙЛЫ ============

enum AttachmentKind {
  RESUME
  COVER_LETTER
  TEST_TASK
  PORTFOLIO
  CONTRACT
  INVOICE
  ACT
  CONSENT
  OTHER
}

model Attachment {
  id             String @id @default(cuid())
  organizationId String

  kind       AttachmentKind
  fileName   String
  fileSize   Int
  mimeType   String
  storageKey String // ключ в S3-совместимом хранилище
  visibility CommentVisibility @default(SHARED)

  candidateId   String?
  candidate     Candidate?   @relation(fields: [candidateId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  vacancyId     String?
  vacancy       Vacancy?     @relation(fields: [vacancyId], references: [id])
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id])
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  agreementId   String?
  agreement     Agreement?   @relation(fields: [agreementId], references: [id])

  uploadedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([candidateId])
  @@index([applicationId])
}

// ============ ФИНАНСЫ ============

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String  @id @default(cuid())
  organizationId String
  clientId       String
  client         Client  @relation(fields: [clientId], references: [id])
  agreementId    String?

  number      String
  status      InvoiceStatus @default(DRAFT)
  amount      Decimal       @db.Decimal(12, 2)
  vatIncluded Boolean       @default(false)
  currency    String        @default("RUB")

  description String?  @db.Text
  vacancyIds  String[] @default([]) // за какие закрытия выставлен

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  fileUrl    String?
  actFileUrl String?

  createdById String
  createdAt   DateTime @default(now())

  attachments Attachment[]

  // Номер счёта — бухгалтерский идентификатор, повторяться он не имеет
  // права. Гарантии не было нигде: номер считался запросом «сколько уже
  // есть» и подставлялся отдельной вставкой, так что два счёта,
  // выписанных в одну секунду, получали один номер. Проверка в коде
  // такое не ловит по определению — гонку останавливает только база.
  @@unique([organizationId, number])
  @@index([clientId, status])
}

// ============ УВЕДОМЛЕНИЯ И ЛОГИ ============

model Notification {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  eventCode String // см. ТЗ раздел 9.2
  title     String
  body      String? @db.Text
  linkUrl   String?
  payload   Json?

  // Ключ схлопывания (BR-30): события с одним ключом в пределах окна
  // не рассылаются по одному, а сводятся в одно сообщение. Обычно это
  // «вакансия + тип события»
  groupKey String?

  isRead Boolean   @default(false)
  readAt DateTime?

  sentEmailAt     DateTime?
  sentVkAt        DateTime?
  /// Пуш принят службой уведомлений хотя бы одного устройства. В отличие
  /// от остальных отметок — только по факту приёма: пуш, не дошедший
  /// ни до одного устройства, «отправленным» не считается.
  sentPushAt      DateTime?
  // Внешние каналы, которых это уведомление ждёт. Пустой массив —
  // уведомление только в интерфейсе
  pendingChannels String[]  @default([])

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, eventCode, groupKey, createdAt])
}

/// Пуш-подписка: один браузер на одном устройстве одного человека
/// (lib/notifications/push.ts).
///
/// Серверу нужно
/// достучаться только до службы уведомлений браузера (Google, Apple,
/// Mozilla), а содержимое зашифровано ключами самого браузера (RFC 8291).
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Адрес службы уведомлений браузера. Уникален: устройство одно,
  /// и когда им начинает пользоваться другой человек, подписка
  /// переезжает к нему, а не двоится.
  endpoint  String  @unique
  /// Ключи шифрования содержимого из PushSubscription.toJSON().
  p256dh    String
  auth      String
  userAgent String?

  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  /// Отказы подряд; успешная доставка обнуляет.
  failureCount  Int       @default(0)

  @@index([userId])
}

/// Черновик сообщения студенту (кабинет клиента, «Студенческая платформа»).
/// Один на пару «пользователь CRM — отклик»: автосохранение поля ввода,
/// пока человек не отправил сообщение. Студент его не видит и не получает
/// уведомлений — это запись только на стороне CRM. Беседа без сообщений
/// показывается в списке «Сообщения» только вместе с непустым черновиком.
model StudentMessageDraft {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// id отклика на студенческой платформе (чужая база — внешнего ключа нет).
  applicationId String
  /// Текст черновика; не длиннее самого сообщения (2000 знаков, как на платформе).
  body          String
  updatedAt     DateTime @updatedAt

  @@unique([userId, applicationId])
  @@index([userId, updatedAt])
}

model ActivityLog {
  id             String  @id @default(cuid())
  organizationId String
  actorId        String?
  actor          User?   @relation(fields: [actorId], references: [id])

  entityType String // "Application" | "Vacancy" | ...
  entityId   String
  action     String // "stage_changed" | "created" | "client_decision" | ...
  diff       Json?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
}

// Отдельный журнал по ПДн — требование 152-ФЗ (BR-36)
model PersonalDataAccessLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String
  candidateId    String
  action         String // "view" | "export" | "download_resume" | "delete"
  ip             String?
  createdAt      DateTime @default(now())

  @@index([candidateId, createdAt])
  @@index([organizationId, createdAt])
}

/// Согласие на предоставление данных конкретному работодателю.
///
/// Общее согласие кандидата (BR-33) разрешает обработку у нас. Передача
/// данных клиенту — отдельное действие с отдельным получателем, и §4.2
/// общего согласия обещает кандидату спрашивать на неё отдельно. Одна
/// запись — один работодатель и одна вакансия: §8.1 документа прямо
/// запрещает распространять подтверждение на другие.
///
/// Наименование и ИНН работодателя, а также название вакансии хранятся
/// снимком, а не только ссылкой. Клиент может переименоваться, вакансия —
/// смениться названием, а подтверждать потом придётся то, что кандидат
/// видел на экране в тот момент, а не то, что лежит в справочнике сейчас.
///
/// Мягкого удаления нет намеренно: это доказательство волеизъявления.
/// Запись, которую можно спрятать фильтром, доказательством быть перестаёт.
model DisclosureConsent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  vacancyId   String
  vacancy     Vacancy   @relation(fields: [vacancyId], references: [id])
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])

  /// Снимок реквизитов на момент показа кандидату (§1 документа).
  employerName String
  employerInn  String?
  vacancyTitle String

  status      ConsentStatus          @default(PENDING)
  /// Версия текста, под которым поставлена галочка.
  version     String?
  /// §4.1: прямые контакты работодателю или общение через агентство.
  /// Пусто, пока кандидат не подтвердил: в документе ни один вариант
  /// не отмечен заранее.
  contactMode DisclosureContactMode?

  givenAt   DateTime?
  /// §6.1: не более 90 календарных дней с даты предоставления.
  expiresAt DateTime?

  /// Одноразовая ссылка на форму подтверждения.
  token          String?   @unique
  tokenExpiresAt DateTime?

  /// §8.3: чем подтверждается волеизъявление.
  ip        String?
  userAgent String?

  /// Кто из агентства запросил подтверждение.
  createdById   String
  createdBy     User    @relation("DisclosureRequestedBy", fields: [createdById], references: [id])
  /// Заполнено, только если согласие отмечено рекрутером вручную —
  /// то есть получено вне системы и подтверждённого следа у него нет.
  confirmedById String?
  confirmedBy   User?   @relation("DisclosureConfirmedBy", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())

  @@index([candidateId, vacancyId])
  @@index([organizationId, status])
}

/// §4.1 документа: два взаимоисключающих варианта передачи контактов.
enum DisclosureContactMode {
  /// Телефон, почта и Telegram уходят работодателю.
  DIRECT
  /// Контакты не передаются, общение идёт через агентство.
  VIA_AGENCY
}

/// Состояние кандидата в контуре уничтожения персональных данных (ст. 21 152-ФЗ).
///
/// Отдельно от ConsentStatus намеренно. Согласие отвечает на вопрос
/// «можно ли обрабатывать», а это — «что мы обязаны сделать и к какому
/// сроку». Отозванное согласие без назначенного срока уничтожения —
/// ровно та дыра, из-за которой данные лежат годами.
enum ErasureState {
  /// Обычная работа.
  ACTIVE
  /// Обработка прекращена, данные заблокированы. Двигать по воронке,
  /// вносить оффер и представлять клиенту нельзя, но записи ещё есть.
  BLOCKED_FOR_ERASURE
  /// Решение принято, стоит в очереди на уничтожение.
  ERASURE_PENDING
  /// Исполнено: персональных данных не осталось, заявки обезличены.
  ANONYMIZED
}

/// Почему возникла обязанность уничтожить. Влияет на разбор обращения:
/// по какому основанию и в какой срок оператор был обязан действовать.
enum ErasureReason {
  /// Кандидат отозвал согласие (ч. 5 ст. 21).
  CONSENT_REVOKED
  /// Срок согласия истёк и не продлён.
  CONSENT_EXPIRED
  /// Прямое требование субъекта об уничтожении.
  SUBJECT_REQUEST
  /// Цель обработки достигнута.
  PURPOSE_ACHIEVED
  /// Сорсинг-лид: согласие не получено за 14 дней.
  SOURCING_EXPIRED
}

/// Заявка с лендинга.
///
/// Отдельно от Client намеренно: клиент - это компания, с которой есть
/// или была работа, а заявка приходит от кого угодно и может оказаться
/// спамом или ошибкой. Смешивать их значит засорять список клиентов
/// и врать в аналитике по конверсии.
///
/// Организация не привязана: форма публичная, и на момент отправки
/// человек ещё не выбрал, с кем работает. В продукте организация одна,
/// а заявка адресована агентству в целом.
model Lead {
  id String @id @default(cuid())

  name      String
  company   String?
  website   String?
  /// Телефон, Telegram или почта - что человек оставил, то и храним:
  /// заставлять выбирать канал на первом касании значит терять заявки.
  contact   String
  /// Сколько вакансий планирует закрыть. Свободная строка из набора
  /// вариантов формы, а не число: «более 5» и «пока формируем план»
  /// это тоже ответы.
  vacancies String?
  note      String?

  status LeadStatus @default(NEW)

  /// Доказательство согласия (юридический пакет, раздел 10).
  ///
  /// Хранится версия текста, а не сам текст: закон требует доказать,
  /// под чем именно человек поставил галочку, а «под тем, что тогда
  /// было на сайте» доказательством не является. Тексты и версии
  /// живут в lib/legal/consent-texts.
  consentVersion String?
  consentAt      DateTime?

  /// Согласие на рекламу - отдельное и добровольное (ст. 18 закона
  /// о рекламе). Обязательным быть не может никогда.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  /// Для разбора спама и злоупотреблений: кто и откуда отправил.
  /// Здесь же техническое доказательство согласия: адрес и клиент,
  /// с которых оно дано.
  ip        String?
  userAgent String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?
  /// Кто разобрал заявку. Без связи на User: заявку может закрыть
  /// человек, которого потом деактивируют, а история должна остаться.
  processedBy String?

  /// Компания, которая зарегистрировалась сама. Заявка заводится
  /// в момент регистрации — тогда же дано согласие, и его момент,
  /// адрес и браузер должны быть того запроса, а не последующих, —
  /// а название компании и вакансия дописываются в неё после анкеты.
  /// Без связи дописывать было бы некуда.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  @@index([status, createdAt])
  @@index([clientId])
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  REJECTED
  SPAM
}

/// Запрос на восстановление пароля.
///
/// Хранится хеш токена, а не сам токен. Утечка базы тогда не даёт
/// возможности войти: по хешу ссылку не восстановить. Хеш быстрый
/// (sha256), а не argon2, потому что токен и так случайный на 32 байта,
/// и подбирать его бессмысленно, а искать по нему надо на каждом запросе.
model PasswordReset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tokenHash String    @unique
  expiresAt DateTime
  /// Одноразовость: использованную ссылку нельзя открыть второй раз.
  usedAt    DateTime?

  /// Откуда просили. Нужно, чтобы разобрать перебор адресов.
  requestedIp String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Код восстановления для входа без телефона.
///
/// Без них двухфакторную аутентификацию включать нельзя: потерянный
/// или разбитый телефон запирает владельца из системы с персональными
/// данными, и восстановить доступ будет некому.
///
/// Хранится хеш: утечка базы не должна давать возможности войти.
/// Argon2, а не sha256, в отличие от ссылок восстановления: код короткий
/// и человекочитаемый, то есть перебираемый, и медленный хеш здесь
/// как раз к месту.
model RecoveryCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  codeHash String
  /// Одноразовость: использованный код больше не подходит.
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}

/// Заявка на самостоятельную регистрацию компании (Client + CLIENT_ADMIN)
/// без приглашения от агентства — два экрана: телефон/почта/пароль,
/// затем код из письма.
///
/// Пароль хешируется уже на первом экране: plaintext не переживает один
/// запрос. Код хешируется argon2, а не sha256, той же логикой, что и
/// RecoveryCode — шесть цифр перебираемы, и медленный хеш здесь к месту.
model PendingClientRegistration {
  id    String @id @default(cuid())
  email String
  phone String

  passwordHash String
  codeHash     String

  /// Версия текста согласия (lib/legal/registration-consent.ts), под которым
  /// поставили галочку — тем же приёмом, что и Lead.consentVersion.
  consentVersion String
  consentAt      DateTime

  expiresAt DateTime
  /// Счётчик неверных попыток — после лимита заявка гасится, чтобы код
  /// нельзя было перебрать даже медленным хешем.
  attempts  Int       @default(0)
  /// Одноразовость: использованная заявка не годится для повторного экрана кода.
  usedAt    DateTime?

  requestedIp String?
  createdAt   DateTime @default(now())

  @@index([email, createdAt])
}

/// Код из SMS для входа и регистрации по номеру телефона.
///
/// Хранится HMAC от кода на AUTH_SECRET, а не сам код: шесть цифр — это
/// миллион вариантов, и по простому хешу из утёкшей базы код подбирается
/// мгновенно, а без секрета — нет. Попытки считаются здесь же, а не только
/// ограничителем частоты по адресу: ограничитель обходится сменой адреса,
/// а счётчик у самого кода — нет.
model PhoneCode {
  id    String @id @default(cuid())
  /// E.164, как в User.phoneVerified.
  phone String

  codeHash  String
  expiresAt DateTime
  /// Неверных вводов. После пятого код больше не принимается вовсе.
  attempts  Int       @default(0)
  usedAt    DateTime?

  /// Откуда просили — разбирать рассылку кодов на чужие номера.
  requestedIp String?

  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

/// Неудачная попытка входа (пароль или код 2FA). Считаем по ключу «аккаунт» и «адрес»:
/// в памяти процесса лимит на Vercel обнуляется с каждым инстансом, а здесь общий.
model AuthFailure {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
  @@index([at])
}

/// Что случилось со входом в CRM.
enum AuthEventKind {
  LOGIN_OK
  LOGIN_FAIL
  TWO_FACTOR_FAIL
  PASSWORD_RESET
  TWO_FACTOR_ENABLED
  TWO_FACTOR_RESET
}

/// Журнал входов (lib/services/auth-events.ts): кто и откуда входил,
/// кто не смог, когда менялся пароль и включалась двухфакторная.
///
/// Почта хранится не открыто, а отпечатком (HMAC-SHA256 на AUTH_SECRET):
/// по журналу можно собрать попытки на один и тот же адрес, но не узнать
/// адрес. userId без внешнего ключа намеренно — запись о входе не должна
/// мешать удалению учётной записи (erasure), а лежит она 90 дней.
/// Секретов в деталях нет: ни паролей, ни кодов.
model AuthEvent {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  kind      AuthEventKind
  userId    String?
  /// Организация пользователя — чтобы владелец видел события только своей
  /// организации без выборки всех её пользователей. Пусто у событий по
  /// неизвестным адресам: принадлежность им определить нечем.
  organizationId String?
  emailHash String?
  ip        String?
  /// Усечён до 255 символов.
  userAgent String?
  /// Способ входа и причина отказа, без секретов.
  details   Json?

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

/// Отметка фонового процесса (jobs/scheduler.ts): каждый проход обновляет
/// одну строку. По ней /api/health/worker отвечает внешней проверке
/// (infra/functions/uptime), жив ли планировщик. Иначе его остановку
/// не видит никто: сайт и кабинет открываются, а письма, напоминания
/// и очередь уничтожения ПДн молча стоят.
model WorkerHeartbeat {
  /// Имя процесса — сейчас один: "scheduler".
  id         String    @id
  /// Последний проход, удачный или нет.
  lastTickAt DateTime
  /// Последний удачный проход. Отстаёт от lastTickAt — проходы падают.
  lastOkAt   DateTime?
}

/// Одноразовый код привязки ВКонтакте: человек пишет его сообществу, и только
/// тогда страница ВК становится его (User.vkUserId). Храним подпись кода, не сам код.
model VkLinkCode {
  id    String @id @default(cuid())
  userId String

  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([codeHash])
}

/// Что приходило от сообщества ВКонтакте на /api/webhooks/vk и чем закончилось.
/// ВК присылает события только после настройки Callback API, и без журнала
/// «бот молчит» — гадание: событий нет вообще, секрет не тот или ответ не ушёл.
/// Хранится 30 дней. Ни текста сообщений (там коды привязки и личная переписка),
/// ни страниц отправителей здесь нет — только тип события и исход.
model VkEvent {
  id String   @id @default(cuid())
  at DateTime @default(now())

  /// Тип события ВК: confirmation, message_new, message_allow и т. д.
  type String
  /// Чем закончилось: confirmed, linked, bad-code, not-a-code, expired, taken,
  /// too-many-attempts, forbidden-secret, ignored, reply-failed.
  outcome String
  /// Код отказа ВК, если не удалось ответить человеку (901 — писать первым нельзя).
  vkErrorCode Int?

  @@index([at])
}
