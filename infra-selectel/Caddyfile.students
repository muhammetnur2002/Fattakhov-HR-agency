# Обратный прокси и автоматический HTTPS для машины студенческой платформы.
#
# Отступы только пробелами: файл уезжает на сервер внутри cloud-init, а тот
# запрещает табуляцию и молча отвергает документ целиком.
#
# Блока на :80 нет намеренно: проверка владения доменом от Let's Encrypt приходит
# именно на порт 80, и любой общий блок на нём сломал бы выпуск сертификата.
#
# Caddy на этой машине включается (students_vm_caddy) только после того, как запись
# students на Рег.ру переключена на её адрес: до этого проверка домена не пройдёт.
#
# Файл на машину попадает так же, как Caddyfile сайта: склеивается Terraform
# с maintenance.caddy и уходит переменной CADDYFILE контейнера caddy в составе
# docker-compose (обычный apply, без пересоздания машины). Копия
# /etc/caddy/Caddyfile из cloud-init осталась для справки и ничем не читается.

{
  email profattakhov@gmail.com

  # API администрирования Caddy (по умолчанию localhost:2019 внутри контейнера)
  # не нужно: конфиг меняется пересозданием контейнера, а не на лету.
  admin off

  # Модуль ограничения запросов (mholt/caddy-ratelimit, образ caddy-rl): ставим до прокси
  order rate_limit before basicauth

  # Защита от медленных и раздутых запросов. Таймаут записи (write) не ставим
  # намеренно: он оборвал бы поток чата SSE (/api/messages/stream). Лимита
  # запросов на клиента в самом Caddy нет (нужен сборочный плагин): входы и
  # отклики ограничивает приложение, здесь — размеры, время чтения и число
  # соединений к приложению.
  servers {
    max_header_size 32KB
    timeouts {
      read_header 15s
      read_body 10m
      idle 5m
    }
  }
}

students.fattakhovhr.ru {
  encode zstd gzip

  # Потолок тела запроса: самая большая загрузка через сервер — 50 МБ (видео,
  # UPLOAD_LIMITS в lib/validation.ts) плюс поля формы. Крупнее файлы идут
  # напрямую в хранилище по presign и через Caddy не проходят.
  request_body {
    max_size 55MB
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    ?Referrer-Policy "same-origin"
    -Server
  }

  # Ограничение запросов с одного IP-адреса (нагрузочный тест 17.10.2026: потолок
  # кабинета ~200 запросов/с, платформы ~100; без лимита один адрес с 400 одновременных
  # запросов замедлял сайт для всех в 5-10 раз). Пороги с запасом для общежитий и вузов,
  # где много студентов за одним адресом: 60 запросов/с в среднем на адрес, но не больше
  # 20 попыток входа/регистрации/сброса в минуту. При превышении - ответ 429 с Retry-After.
  # route фиксирует порядок: сначала отсекаем сканеры, потом считаем лимиты, потом прокси.
  route {
    @scanners path /.env* /.git/* /.svn/* /.hg/* /.aws/* /.ssh/* /.DS_Store /wp-admin* /wp-login.php /wp-content/* /wp-includes/* /xmlrpc.php /phpmyadmin* /pma/* /cgi-bin/* /vendor/phpunit/* /server-status /actuator/* /etc/passwd /boot.ini /config.php /admin.php /shell.php
    abort @scanners

    rate_limit {
      zone stu_auth {
        match {
          method POST
          path /login* /api/auth/* /register* /api/register* /forgot* /reset* /api/password* /api/login* /api/invite* /invite/*
        }
        key {remote_host}
        events 20
        window 1m
      }
      zone stu_writes {
        match {
          method POST PUT PATCH DELETE
        }
        key {remote_host}
        events 180
        window 1m
      }
      zone stu_general {
        key {remote_host}
        events 600
        window 10s
      }
    }
  }

  # Страница «технические работы» — см. Caddyfile и maintenance.caddy. Бренд
  # и подпись у платформы свои.
  import maintenance_gate "Fattakhov Students" "Студенческая платформа"
  import maintenance_errors "Fattakhov Students" "Студенческая платформа"

  # flush_interval -1: чат платформы получает новые сообщения потоком
  # (SSE, /api/messages/stream) — ответ отдаётся сразу, без буфера Caddy
  reverse_proxy students:3000 {
    flush_interval -1
    header_up X-Forwarded-For {remote_host}
    header_up X-Real-IP {remote_host}

    # До 512 соединений к приложению: потоки чата живут долго, по одному на
    # открытую вкладку, поэтому запас больше, чем у кабинета.
    transport http {
      dial_timeout 5s
      response_header_timeout 120s
      max_conns_per_host 512
    }
  }
}
